# Copy to .env and fill in. The .env file never goes into the repository.
# Every variable is optional for the demo: DEMO_MODE=true runs offline on fixtures.

# --- Mode ---------------------------------------------------------------------------------
# true = offline: fixture inbox instead of the API, local outbox instead of Microsoft Graph
DEMO_MODE=true
# true = print the alert instead of delivering it (safe default; set false to deliver)
DRY_RUN=true

# --- Electronic judicial domicile (PDPJ) -------------------------------------------------
# API credentials issued in the PDPJ client-management portal (one per environment)
PDPJ_CLIENT_ID=
PDPJ_CLIENT_SECRET=
# Tax id (11 digits) of the responsible lawyer, sent as the On-behalf-Of audit header
PDPJ_ON_BEHALF_OF_CPF=
# staging | production
PDPJ_ENVIRONMENT=staging
# oauth (works; token from the PDPJ Keycloak SSO) | basic (declared by the Swagger, answers 401)
PDPJ_AUTH_MODE=oauth
# Leave empty: the verified defaults per environment are in the code
PDPJ_TOKEN_URL=
PDPJ_BASE_URL_STAGING=
PDPJ_BASE_URL_PRODUCTION=
# tenantId (UUID). Empty = resolved automatically through GET /api/v1/eu on the first run;
# store the printed value here to save a call
PDPJ_TENANT_ID=

# Additional monitored inboxes (clients), one credential each; see client_accounts.json.example
CLIENT_ACCOUNTS_PATH=client_accounts.json
# Name shown for the main inbox in alerts
PRIMARY_ACCOUNT_NAME=primary

# --- Sweep ---------------------------------------------------------------------------------
# Days to look back; the state ignores notices already seen, so overlap is harmless
WINDOW_DAYS=7
# Mark the alert [URGENT] when an acknowledgement deadline is within this many days
URGENT_DEADLINE_DAYS=1

# --- E-mail (Microsoft 365 / Graph, application permission Mail.Send) --------------------
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
EMAIL_SENDER=notices@example.com
# Comma-separated recipients
EMAIL_RECIPIENTS=

# --- Local state ---------------------------------------------------------------------------
# Default: .demo/state.sqlite in demo mode, data/state.sqlite otherwise
# DB_PATH=
# Demo mode only
# FIXTURES_PATH=fixtures/notices.json
# OUTBOX_DIR=.demo/outbox
